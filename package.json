{
  "name": "marshmallow-frontend-test",
  "private": true,
  "version": "1.0.0",
  "author": "Liam Canetti <liam.canettti@marshmallow.co>",
  "contributors": [
    "Ella Taylor <ella.taylor@marshmallow.co>",
    "Liam Piesley <liam.piesley@marshmallow.co>",
    "Rowan Henseleit <rowan.henseleit@marshmallow.co>",
    "Mat Diak <mat.diak@marshmallow.co>"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "gen-types": "curl https://api.spacexdata.com/v4/launches | npx quicktype -o src/types/generated/launches.ts --just-types --lang typescript\n curl https://api.spacexdata.com/v4/payloads | npx quicktype -o src/types/generated/payload.ts --just-types --lang typescript\n"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.6",
    "rc-pagination": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^7.1.3",
    "react-select": "^5.10.0",
    "styled-components": "^6.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.12.0",
    "@types/prettier": "^2.7.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.18",
    "jsdom": "^22.1.0",
    "prettier": "^3.4.2",
    "quicktype": "^23.0.171",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^4.5.9",
    "vitest": "^0.34.6"
  }
}
